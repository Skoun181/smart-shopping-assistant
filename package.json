{
  "name": "smart-shopping-assistant",
  "private": true,
  "version": "1.1.0-dev.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node scripts/server.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "hash-password": "node scripts/hash-password.mjs",
    "db:backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "^6.0.2",
    "@sveltejs/kit": "^3.3.0",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "svelte": "^5.57.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "latest",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "svelte-check": "latest",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
