{
  "extends": "$app/tsconfig",
  "include": [
    "src",
    "tests",
    "vite.config.ts"
  ],
  "exclude": [
    "src/service-worker"
  ],
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "$app/types"
    ]
  }
}
