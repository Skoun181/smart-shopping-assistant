# Generate with: npm run hash-password
# IMPORTANT: Keep single quotes around the hash to prevent Docker Compose $ interpolation.
# Never commit your real .env file or share credentials.
APP_PASSWORD_HASH=REPLACE_WITH_GENERATED_HASH
# Network origin is determined automatically; old ORIGIN and BIND_ADDRESS are no longer used.
# Direct HTTP is LAN-only; use trusted HTTPS reverse proxy for sensitive data.
APP_PORT=3000

# Optional: local Ollama vision model. Do not configure a cloud endpoint.
# PANTRY_VISION_URL=http://192.168.178.60:11434/
# PANTRY_VISION_MODEL=your-installed-local-vision-model
